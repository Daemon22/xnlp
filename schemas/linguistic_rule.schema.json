{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XNLP linguistic rule",
  "type": "object",
  "required": ["rule_id", "category", "description", "examples", "source_record_ids", "confidence", "frequency"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "rule": {},
    "examples": {"type": "array"},
    "counterexamples": {"type": "array"},
    "source_record_ids": {"type": "array", "items": {"type": "string"}},
    "source_works": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["OBSERVED", "HIGH_CONFIDENCE", "SUPPORTED", "PROVISIONAL", "INSUFFICIENT_EVIDENCE", "CONFLICTING_EVIDENCE"]},
    "frequency": {"type": "integer", "minimum": 0},
    "variant_forms": {"type": "array"},
    "orthographic_forms": {"type": "array"},
    "notes": {"type": "string"}
  }
}
