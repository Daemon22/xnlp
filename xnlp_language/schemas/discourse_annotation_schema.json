{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XNLP Evidence-Linked Discourse Annotation",
  "description": "Human annotation format for discourse components and relations with explicit source spans.",
  "type": "object",
  "definitions": {
    "evidence": {
      "type": "object",
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "source_work": { "type": "string" },
        "source_section": { "type": "string" },
        "source_text": { "type": "string", "minLength": 1 }
      },
      "required": ["record_id", "source_text"],
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "surface": { "type": "string", "minLength": 1 }
      },
      "required": ["record_id", "start", "end", "surface"],
      "additionalProperties": false
    }
  },
  "properties": {
    "annotation_id": { "type": "string", "minLength": 1 },
    "annotation_status": {
      "type": "string",
      "enum": ["UNREVIEWED", "IN_REVIEW", "REVIEWED", "ESTABLISHED", "CONTESTED", "REJECTED"]
    },
    "status": { "type": "string", "enum": ["pending", "adjudicated", "disputed"] },
    "assigned_lemma": { "type": ["string", "null"] },
    "assigned_category": { "type": ["string", "null"] },
    "assigned_meaning": { "type": ["string", "null"] },
    "adjudicator": { "type": ["string", "null"], "enum": ["human", "rule-assisted-human", "machine-only", "auto-evidence", null] },
    "adjudication_note": { "type": ["string", "null"] },
    "flagged_by": { "type": ["string", "null"], "enum": ["machine-only", null] },
    "auto_evidence": { "type": ["object", "null"] },
    "adjudication_history": { "type": "array", "items": { "type": "object" } },
    "evidence_state": {
      "type": "string",
      "enum": ["OBSERVED", "CANDIDATE", "SOURCE_SUPPORTED", "CROSS_SOURCE_SUPPORTED", "VALIDATED", "ESTABLISHED", "REJECTED", "UNRESOLVED"],
      "description": "Claim evidence state; independent of confidence and human workflow status."
    },
    "confidence": {
      "type": "string",
      "enum": ["OBSERVED", "SUPPORTED", "HIGH_CONFIDENCE", "PROVISIONAL", "INSUFFICIENT_EVIDENCE", "CONFLICTING_EVIDENCE"]
    },
    "discourse_function": { "type": "string" },
    "speaker_context": { "type": "string" },
    "ambiguity": { "type": "array", "items": { "type": "string" } },
    "machine_suggestion": {
      "type": ["object", "null"],
      "properties": {
        "suggestion": { "type": "string" },
        "producer": { "type": "string" },
        "evidence_state": { "type": "string", "enum": ["CANDIDATE", "UNRESOLVED"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["suggestion", "producer", "evidence_state"],
      "additionalProperties": false
    },
    "reviewer_decision": {
      "type": ["object", "null"],
      "properties": {
        "decision": { "type": "string", "enum": ["ACCEPT", "REJECT", "UNRESOLVED"] },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "protocol_id": { "type": "string", "minLength": 1 },
        "evidence_record_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "required": ["decision", "reviewer_id", "protocol_id", "evidence_record_ids"],
      "additionalProperties": false
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "component_type": { "type": "string", "minLength": 1 },
          "span": { "$ref": "#/definitions/span" },
          "interpretation": { "type": "string" },
          "contextual_role": { "type": "string" },
          "reference_target": { "type": "string" },
          "uncertainties": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["component_id", "component_type", "span"],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation_id": { "type": "string", "minLength": 1 },
          "source_component_id": { "type": "string", "minLength": 1 },
          "target_component_id": { "type": "string", "minLength": 1 },
          "relation_label": {
            "type": "string",
            "minLength": 1,
            "description": "Annotator-supplied relation label; do not force an unsupported fixed inventory."
          },
          "evidence_spans": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/span" }
          },
          "uncertainties": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "relation_id",
          "source_component_id",
          "target_component_id",
          "relation_label",
          "evidence_spans"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "validated_by": { "type": "array", "items": { "type": "string" } },
    "reviewer_notes": { "type": "string" }
  },
  "required": [
    "annotation_id",
    "annotation_status",
    "confidence",
    "source_evidence",
    "components",
    "relations"
  ],
  "additionalProperties": false
}
