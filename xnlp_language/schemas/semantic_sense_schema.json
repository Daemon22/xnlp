{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XNLP Reviewed Semantic Sense Schema",
  "description": "A human-reviewed lexical sense grounded in an eligible source record.",
  "type": "object",
  "properties": {
    "sense_id": { "type": "string" },
    "lemma": { "type": "string" },
    "gloss": { "type": "string" },
    "noun_class_id": { "type": "string" },
    "review_status": { "type": "string", "enum": ["HUMAN_REVIEWED"] },
    "confidence": {
      "type": "string",
      "enum": ["OBSERVED", "SUPPORTED", "HIGH_CONFIDENCE"]
    },
    "source_foundation_file": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "record_id": { "type": "string" },
          "source_work": { "type": "string" },
          "surface_form": { "type": "string" }
        },
        "required": ["record_id", "source_work", "surface_form"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sense_id", "lemma", "gloss", "noun_class_id", "review_status",
    "confidence", "source_foundation_file", "evidence"
  ],
  "additionalProperties": false
}
