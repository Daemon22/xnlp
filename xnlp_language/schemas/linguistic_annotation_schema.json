{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XNLP corpus-linked linguistic annotation task",
  "type": "object",
  "required": ["task_id", "task_type", "surface_form", "status", "proposed_analysis", "confidence", "source_record_ids", "evidence"],
  "properties": {
    "task_id": {"type": "string"},
    "task_type": {"enum": ["LEXICAL_LEMMA", "MORPHOLOGY_SEGMENTATION", "NOUN_CLASS_OR_AGREEMENT"]},
    "surface_form": {"type": "string"},
    "status": {"enum": ["PENDING_HUMAN_REVIEW", "REVIEWED", "REJECTED"]},
    "proposed_analysis": {"type": ["object", "null"]},
    "confidence": {"enum": ["OBSERVED", "SUPPORTED", "HIGH_CONFIDENCE", "PROVISIONAL", "INSUFFICIENT_EVIDENCE", "CONFLICTING_EVIDENCE"]},
    "source_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1},
    "instruction": {"type": "string"}
  },
  "additionalProperties": false
}
