data/reports/v2_baseline_validation.json
data/reports/v2_corpus_integrity.json
data/reports/v2_tokenizer_fixed_benchmark.json
data/reports/v2_tokenizer_fixed_release_gate.json
# Evaluation reports (per-experiment)
data/reports/evaluation_*.json
data/reports/foundation_review_queue_analysis.json
# V2 tokenizer & model artifacts (generated by benchmark → train → gate)
artifacts/
# V2 training run logs and checkpoints (regenerated by start_v2_training.py)
runs/
# Temporary quick-corpus for CPU-only training validation
corpus_v2_quick/
# Machine-local sandbox configuration (never commit)
.poolside/settings.local.yaml
